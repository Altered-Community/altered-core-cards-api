{% extends 'admin/layout.html.twig' %}

{% block title %}Importer un gameplay format — Admin{% endblock %}

{% block content %}

<div class="mb-4">
    <a href="{{ path('admin_gameplay_formats_index') }}" class="text-sm text-blue-600 hover:underline">← Retour à la recherche</a>
</div>

<div class="max-w-2xl bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-5 mb-6">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">Importer un gameplay format depuis une URL</h2>

    <form method="post" action="{{ path('admin_gameplay_formats_import') }}" class="space-y-4">
        <input type="hidden" name="_token" value="{{ csrf_token('gameplay_format_import') }}">

        <div>
            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Nom du gameplay format</label>
            <input type="text" name="formatName" value="{{ formatName }}" required
                   placeholder="ex : FRONTIER"
                   class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
        </div>

        <div>
            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">URL du fichier JSON</label>
            <input type="url" name="url" value="{{ url }}" required
                   placeholder="https://.../frontier.json"
                   class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white font-mono">
            <p class="mt-1 text-xs text-gray-400">
                Allowlist : <code>{ "id": "...", "version": 1, "included_refs": ["..."] }</code>
                — ou ban-list : <code>{ "id": "...", "version": 1, "excluded_sets": ["..."], "excluded_refs": ["..."] }</code>.
            </p>
        </div>

        <div class="flex items-start gap-2">
            <input type="checkbox" id="resetPrevious" name="resetPrevious" value="1" {{ resetPrevious ? 'checked' : '' }}
                   class="mt-0.5 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600">
            <label for="resetPrevious" class="text-xs text-gray-700 dark:text-gray-300">
                Réinitialiser les anciennes cartes — retire ce format des cartes qui étaient précédemment taguées
                mais qui ne sont plus dans le fichier importé. Sans cette option, l'import n'est qu'additif :
                les anciennes cartes gardent le tag même si elles ne sont plus dans le fichier.
            </label>
        </div>

        <div class="flex gap-2 pt-2 border-t border-gray-100 dark:border-gray-700">
            <button type="submit"
                    class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300">
                Valider le fichier
            </button>
        </div>
    </form>
</div>

{% if preview and preview.ok %}
<div class="max-w-2xl bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-5">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">Aperçu de l'import</h2>

    <dl class="space-y-2 text-sm mb-5">
        <div class="flex justify-between">
            <dt class="text-gray-500 dark:text-gray-400">Gameplay format</dt>
            <dd class="font-mono font-semibold text-gray-900 dark:text-white">{{ formatName|upper }}</dd>
        </div>
        <div class="flex justify-between">
            <dt class="text-gray-500 dark:text-gray-400">Fichier source</dt>
            <dd class="font-mono text-xs text-gray-700 dark:text-gray-300">{{ preview.sourceId }} (v{{ preview.version }})</dd>
        </div>
        <div class="flex justify-between">
            <dt class="text-gray-500 dark:text-gray-400">Type de fichier</dt>
            <dd class="text-gray-900 dark:text-white">{{ preview.mode == 'exclusion' ? 'Ban-list (excluded_sets / excluded_refs)' : 'Allowlist (included_refs)' }}</dd>
        </div>
        {% if preview.mode == 'exclusion' and preview.excludedSetCodes|length %}
        <div class="flex justify-between">
            <dt class="text-gray-500 dark:text-gray-400">Sets exclus</dt>
            <dd class="font-mono text-xs text-gray-900 dark:text-white">{{ preview.excludedSetCodes|join(', ') }}</dd>
        </div>
        {% endif %}
        <div class="flex justify-between">
            <dt class="text-gray-500 dark:text-gray-400">{{ preview.mode == 'exclusion' ? 'Références bannies dans le fichier' : 'Références dans le fichier' }}</dt>
            <dd class="text-gray-900 dark:text-white">{{ preview.totalRefs }}</dd>
        </div>
        <div class="flex justify-between">
            <dt class="text-gray-500 dark:text-gray-400">{{ preview.mode == 'exclusion' ? 'Cartes légales en base' : 'Cartes correspondantes en base' }}</dt>
            <dd class="text-green-700 dark:text-green-400 font-semibold">{{ preview.matchedCardGroupIds|length }}</dd>
        </div>
        <div class="flex justify-between">
            <dt class="text-gray-500 dark:text-gray-400">{{ preview.mode == 'exclusion' ? 'Références bannies introuvables' : 'Références introuvables' }}</dt>
            <dd class="{{ preview.unmatchedRefs|length ? 'text-amber-600 dark:text-amber-400 font-semibold' : 'text-gray-400' }}">
                {{ preview.unmatchedRefs|length }}
            </dd>
        </div>
        <div class="flex justify-between">
            <dt class="text-gray-500 dark:text-gray-400">Réinitialiser les anciennes cartes</dt>
            <dd class="{{ resetPrevious ? 'text-amber-600 dark:text-amber-400 font-semibold' : 'text-gray-400' }}">
                {{ resetPrevious ? 'Oui' : 'Non' }}
            </dd>
        </div>
    </dl>

    {% if preview.unmatchedRefs|length %}
        <div class="mb-5 p-3 rounded-lg bg-amber-50 dark:bg-amber-950 border border-amber-200 dark:border-amber-800">
            <p class="text-xs font-medium text-amber-800 dark:text-amber-300 mb-2">
                {{ preview.mode == 'exclusion' ? 'Références bannies non trouvées en base (sans effet) :' : 'Références non trouvées en base (ignorées) :' }}
            </p>
            <div class="flex flex-wrap gap-1 max-h-32 overflow-y-auto">
                {% for ref in preview.unmatchedRefs|slice(0, 50) %}
                    <span class="px-1.5 py-0.5 text-xs rounded bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-300 font-mono">{{ ref }}</span>
                {% endfor %}
                {% if preview.unmatchedRefs|length > 50 %}
                    <span class="px-1.5 py-0.5 text-xs text-amber-600 dark:text-amber-400">+{{ preview.unmatchedRefs|length - 50 }} autres</span>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% if preview.matchedCardGroupIds|length %}
        <form method="post" action="{{ path('admin_gameplay_formats_import_confirm') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('gameplay_format_import_confirm') }}">
            <input type="hidden" name="formatName" value="{{ formatName }}">
            <input type="hidden" name="url" value="{{ url }}">
            <input type="hidden" name="resetPrevious" value="{{ resetPrevious ? '1' : '0' }}">
            <button type="submit"
                    class="px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 focus:ring-4 focus:ring-green-300">
                Confirmer l'import — appliquer à {{ preview.matchedCardGroupIds|length }} carte(s)
            </button>
        </form>
    {% else %}
        <p class="text-sm text-gray-400">Aucune carte correspondante trouvée, rien à importer.</p>
    {% endif %}
</div>
{% endif %}

{% endblock %}
