      "translations": {
        "en_US": {
          "text": "After months of expeditions, Aedyt felt she had finally spread her wings.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Nach Monaten voller Expeditionen hatte Aedyt das Gefühl, endlich ihre Flügel ausgebreitet zu haben.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Dopo mesi di spedizioni, Aedyt sentiva di aver finalmente spiegato le sue ali.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Tras meses de expediciones, Aedyt sintió que por fin había desplegado sus alas.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Après plusieurs mois d'expéditions, Aedyt sentit qu'elle était enfin parvenue à déployer ses ailes.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC22HP5Z13NM1N61WQKYP",
      "text": "After months of expeditions, Aedyt felt she had finally spread her wings."
