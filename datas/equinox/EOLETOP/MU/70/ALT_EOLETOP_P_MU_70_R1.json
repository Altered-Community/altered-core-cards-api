      },
      "translations": {
        "en_US": {
          "text": "Even the shyest become a bit less reserved when they hear its song.",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "Selbst die Schüchternsten lassen sich durch sein Lied aus der Reserve locken.",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "Anche i più timidi diventano un po' meno riservati quando sentono il suo canto.",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "Incluso los más tímidos se sueltan un poco al oír su canto.",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "Même les plus impassibles sortent de leur réserve en entendant son chant.",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGC03TVSGFY677K6JNHPQQ",
      "text": "Even the shyest become a bit less reserved when they hear its song."
