        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"Calling the Tengu means submitting to anger and vanity, no?\" - Basira",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Den Tengu zu rufen bedeutet, sich seinem Zorn und seiner Eitelkeit zu unterwerfen, nicht wahr?“ – Basira",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"Chiamare il Tengu significa sottomettersi alla rabbia e alla vanità, no?\" - Basira",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Llamar al Tengu significa someterse a la ira y la vanidad, ¿no?». — Basira",
          "locale": "es_ES"
        },
        "fr_FR": {
          "text": "« Appeler le Tengu ne veut-il pas dire céder à la colère et à la vanité ? » - Basira",
          "locale": "fr_FR"
        }
      },
      "id": "01JNRGBX0JKP2EVPXP2FBAKHKH",
      "text": "\"Calling the Tengu means submitting to anger and vanity, no?\" - Basira"
    }
