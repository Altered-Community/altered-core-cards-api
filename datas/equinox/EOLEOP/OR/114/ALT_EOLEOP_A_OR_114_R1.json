                "type": "OUTPUT",
                "translations": {
                  "en_US": {
                    "text": "#I can't be played# unless there's another Character in each of your Expeditions.",
                    "locale": "en_US"
                  },
                  "it_IT": {
                    "text": "#Non puoi giocarmi# a meno che non ci sia un altro personaggio in ciascuna delle tue spedizioni.",
                    "locale": "it_IT"
                  },
                  "de_DE": {
                    "text": "#Ich kann nicht gespielt werden,# es sei denn, es befindet sich ein anderer Charakter in jeder deiner Expeditionen.",
                    "locale": "de_DE"
                  },
                  "fr_FR": {
                    "text": "#Je ne peux pas être jouée,# sauf s'il y a un autre Personnage dans chacune de vos Expéditions.",
                    "locale": "fr_FR"
                  },
                  "es_ES": {
                    "text": "#No puedes jugarme# a menos que haya otro personaje en cada una de tus expediciones.",
                    "locale": "es_ES"
                  }
                },
                "text": "#I can't be played# unless there's another Character in each of your Expeditions."
              }
            ],
