        "reference": "FLAVOR_TEXT",
        "subject": "Flavor Text"
      },
      "translations": {
        "en_US": {
          "text": "\"I know they will all be driven out, except for those who die.\" — Jeanne",
          "locale": "en_US"
        },
        "fr_FR": {
          "text": "« Je sais qu'ils seront tous boutés, excepté ceux qui périront. » — Jeanne",
          "locale": "fr_FR"
        },
        "de_DE": {
          "text": "„Sie werden alle vertrieben, bis auf jene, die sterben.“ — Jeanne",
          "locale": "de_DE"
        },
        "it_IT": {
          "text": "\"So che saranno tutti scacciati, eccetto coloro che periranno.\" — Giovanna",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«Sé que todos serán expulsados, excepto los que mueran». —Jeanne",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HVV6GDEPPC9B4E5WTF5S",
      "text": "\"I know they will all be driven out, except for those who die.\" — Jeanne"
    }
  ],
