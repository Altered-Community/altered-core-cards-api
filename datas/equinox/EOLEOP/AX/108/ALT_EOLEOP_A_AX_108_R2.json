        "de_DE": {
          "text": "„Warum hast du überlebt, Treyst … und ich nicht?“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Pourquoi as-tu survécu alors que je suis mort, Treyst ? »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Perché tu sei sopravvissuto e io sono morto, Treyst?\"",
          "locale": "it_IT"
        },
        "es_ES": {
