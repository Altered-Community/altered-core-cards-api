      "translations": {
        "en_US": {
          "text": "\"Why did you survive, Treyst… but I died?\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Warum hast du überlebt, Treyst … und ich nicht?“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Pourquoi as-tu survécu alors que je suis mort, Treyst ? »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Perché tu sei sopravvissuto e io sono morto, Treyst?\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«¿Por qué sobreviviste tú, Treyst, pero yo tuve que morir?».",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HPEBVHWSPB5J5RTY6YRA",
      "text": "\"Why did you survive, Treyst… but I died?\""
