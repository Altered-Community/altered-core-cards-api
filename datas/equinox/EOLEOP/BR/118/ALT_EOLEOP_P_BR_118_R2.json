      },
      "translations": {
        "en_US": {
          "text": "\"If we are to fall, let this be our last stand!\"",
          "locale": "en_US"
        },
        "de_DE": {
          "text": "„Wenn wir fallen, dann hier und jetzt!“",
          "locale": "de_DE"
        },
        "fr_FR": {
          "text": "« Si nous devons tomber, que ce soit notre baroud d'honneur ! »",
          "locale": "fr_FR"
        },
        "it_IT": {
          "text": "\"Se dobbiamo cadere, allora questa sarà la nostra ultima resistenza!\"",
          "locale": "it_IT"
        },
        "es_ES": {
          "text": "«¡Si caemos, que sea en un acto de resistencia final!».",
          "locale": "es_ES"
        }
      },
      "id": "01KC94HQDW7Q3R96J7WKNYQYBN",
      "text": "\"If we are to fall, let this be our last stand!\""
